<% content_for(:title, "Pipelines") %>

<div class="page-head">
  <h1 class="page-title">Pipelines</h1>
</div>

<div class="toolbar">
  <%= render("ductwork/shared/status_tabs", counts: @status_counts, statuses: @statuses) %>
  <div class="menus">
    <%= render("ductwork/shared/filter_menu", label: "Class", param: :klass, options: @klasses) %>
  </div>
</div>

<%= render("ductwork/shared/runs_table", runs: @runs, error_counts: @error_counts) %>
<%= render("ductwork/shared/pager", total: @run_count) %>
