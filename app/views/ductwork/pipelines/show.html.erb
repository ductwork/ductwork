<% content_for(:title, @pipeline.klass) %>

<div class="page-head">
  <div class="crumbs"><%= link_to("Pipelines", pipelines_path) %> / <%= link_to(@pipeline.klass, pipelines_path(klass: @pipeline.klass)) %></div>
  <div class="run-title">
    <h1 class="page-title"><%= @pipeline.klass %></h1>
    <%= status_badge(@last_run.status) %>
  </div>
  <code class="run-id"><%= @pipeline.id %></code>
</div>

<% if @halts.any? %>
  <p class="notice">Halted on <%= halt_summary(@halts) %></p>
<% end %>

<dl class="facts">
  <div class="fact"><dt>Runtime</dt><dd><%= runtime(@last_run) %></dd></div>
  <div class="fact"><dt>Triggered</dt><dd><%= timestamp(@last_run.triggered_at) %></dd></div>
  <div class="fact"><dt>Started</dt><dd><%= timestamp(@last_run.started_at) %></dd></div>
  <% if @last_run.halted_at.present? %>
    <div class="fact"><dt>Halted</dt><dd><%= timestamp(@last_run.halted_at) %></dd></div>
  <% else %>
    <div class="fact"><dt>Completed</dt><dd><%= timestamp(@last_run.completed_at) %></dd></div>
  <% end %>
  <div class="fact"><dt>Step errors</dt><dd><%= count_badge(@error_count) %></dd></div>
  <% if @run_count > 1 %>
    <div class="fact"><dt>Run</dt><dd>Latest of <%= @run_count %></dd></div>
  <% end %>
</dl>

<% if @graph.present? %>
  <section class="panel" aria-label="Workflow">
    <%= render("graph", graph: @graph) %>
  </section>
<% end %>

<section class="section" id="steps">
  <div class="section-head">
    <h2 class="section-title">
      Steps (<%= @step_count %><%= " of #{@step_total}" if params.values_at(:klass, :node, :status).any?(&:present?) %>)
    </h2>
  </div>

  <div class="toolbar">
    <%= render("ductwork/shared/status_tabs", counts: @status_counts, statuses: @statuses, anchor: "steps") %>
    <div class="menus">
      <%= render("ductwork/shared/filter_menu", label: "Class", param: :klass, options: @klasses, anchor: "steps") %>
      <%= render("ductwork/shared/filter_menu", label: "Node", param: :node, options: @nodes, anchor: "steps") %>
    </div>
  </div>

  <div class="panel">
    <% if @steps.empty? %>
      <p class="empty">No steps match.</p>
    <% else %>
      <div class="row-grid row-grid-steps row-head">
        <span>Step</span>
        <span>Status</span>
        <span class="wide-only">Transition</span>
        <span>Attempts</span>
        <span class="wide-only">Started</span>
        <span class="wide-only">Runtime</span>
        <span></span>
      </div>
      <%= render(partial: "step", collection: @steps, as: :step) %>
    <% end %>
  </div>

  <%= render("ductwork/shared/pager", total: @step_count, anchor: "steps") %>
</section>
