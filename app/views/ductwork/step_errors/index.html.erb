<% content_for(:title, "Step errors") %>

<div class="page-head">
  <h1 class="page-title">Step errors</h1>
</div>

<div class="toolbar">
  <div class="menus">
    <%= render("ductwork/shared/filter_menu", label: "Class", param: :klass, options: @klasses) %>
  </div>
</div>

<div class="panel">
  <% if @step_errors.empty? %>
    <p class="empty">No step errors match.</p>
  <% else %>
    <div class="row-grid row-grid-errors row-head">
      <span>When</span>
      <span>Error</span>
      <span>Step</span>
      <span>Pipeline</span>
      <span></span>
    </div>
    <% @step_errors.each do |result| %>
      <% step = result.execution.job.step %>
      <details class="row">
        <summary class="row-grid row-grid-errors">
          <span class="wide-only"><%= timestamp(result.created_at) %></span>
          <span class="cell-truncate">
            <span class="error-title"><%= result.error_klass %></span>
            <%= result.error_message %>
          </span>
          <span class="cell-truncate wide-only"><%= step.klass %></span>
          <span class="wide-only"><%= short_id(step.run.pipeline_id) %></span>
        </summary>
        <div class="row-body">
          <div class="detail-grid">
            <div>
              <span class="detail-label">Step</span>
              <div><%= step.klass %> <code><%= step.id %></code></div>
            </div>
            <div>
              <span class="detail-label">Pipeline</span>
              <%= link_to(step.run.pipeline_klass, pipeline_path(step.run.pipeline_id)) %>
              <code><%= step.run.pipeline_id %></code>
            </div>
          </div>
          <div class="detail-block">
            <%= render("ductwork/shared/error", result:) %>
          </div>
        </div>
      </details>
    <% end %>
  <% end %>
</div>

<%= render("ductwork/shared/pager", total: @error_count) %>
