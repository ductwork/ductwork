<% content_for(:title, "Overview") %>

<section class="section">
  <div class="panel stats">
    <%= link_to(pipelines_path(status: "in_progress"), class: "stat") do %>
      <span class="stat-value"><%= number_with_delimiter(@metrics[:in_progress]) %></span>
      In progress
    <% end %>
    <%= link_to(pipelines_path(status: "halted"), class: "stat", data: { alert: @metrics[:halted].positive? }) do %>
      <span class="stat-value"><%= number_with_delimiter(@metrics[:halted]) %></span>
      Halted
    <% end %>
    <%= link_to(pipelines_path(status: "completed"), class: "stat") do %>
      <span class="stat-value"><%= number_with_delimiter(@metrics[:completed]) %></span>
      Completed
    <% end %>
    <%= link_to(step_errors_path, class: "stat") do %>
      <span class="stat-value"><%= number_with_delimiter(@metrics[:step_errors]) %></span>
      Step errors
    <% end %>
  </div>
</section>

<% if @halted_runs.any? %>
  <section class="section">
    <div class="section-head">
      <h2 class="section-title">Needs attention</h2>
      <%= link_to("All halted", pipelines_path(status: "halted")) %>
    </div>
    <div class="panel">
      <% @halted_runs.each do |run| %>
        <div class="halt">
          <div>
            <%= link_to(run.pipeline_klass, pipeline_path(run.pipeline_id), class: "table-primary") %>
            <%= short_id(run.pipeline_id) %>
          </div>
          <div class="halt-reason"><%= halt_summary(@halts.fetch(run.id, {})) %></div>
          <div class="halt-time"><%= timestamp(run.halted_at) %></div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<section class="section">
  <div class="section-head">
    <h2 class="section-title">Pipelines by class</h2>
  </div>
  <div class="panel table-scroller">
    <% if @class_summaries.empty? %>
      <p class="empty">No pipelines have been triggered yet.</p>
    <% else %>
      <table class="table">
        <thead>
          <tr>
            <th>Class</th>
            <th class="numeric">Active</th>
            <th class="numeric">Halted</th>
            <th class="numeric">Completed</th>
            <th>Last started</th>
          </tr>
        </thead>
        <tbody>
          <% @class_summaries.each do |summary| %>
            <tr data-href="<%= pipelines_path(klass: summary[:klass]) %>">
              <td><%= link_to(summary[:klass], pipelines_path(klass: summary[:klass]), class: "table-primary") %></td>
              <td class="numeric"><%= number_with_delimiter(summary[:active]) %></td>
              <td class="numeric"><%= count_badge(summary[:halted]) %></td>
              <td class="numeric"><%= number_with_delimiter(summary[:completed]) %></td>
              <td><%= timestamp(summary[:last_started_at]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</section>

<section class="section">
  <div class="section-head">
    <h2 class="section-title">Recent runs</h2>
    <%= link_to("All pipelines", pipelines_path) %>
  </div>
  <%= render("ductwork/shared/runs_table", runs: @runs, error_counts: @error_counts) %>
</section>
