<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= [content_for(:title), "Ductwork"].compact.join(" · ") %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Ductwork">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "ductwork/application.css" %>

    <%= javascript_include_tag "ductwork/application.js", type: "module" %>

    <link rel="icon" href="<%= image_url("ductwork/logo.png") %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= image_url("ductwork/logo.png") %>" type="image/png">
  </head>

  <body>
    <header class="topbar">
      <div class="shell topbar-inner">
        <%= link_to(dashboard_path, class: "brand") do %>
          <%= image_tag("ductwork/logo.png", alt: "") %>
          <span>Ductwork</span>
        <% end %>

        <nav class="nav" aria-label="Dashboard">
          <%= link_to("Overview", dashboard_path, aria: { current: controller_name == "dashboards" ? "page" : nil }) %>
          <%= link_to("Pipelines", pipelines_path, aria: { current: controller_name == "pipelines" ? "page" : nil }) %>
          <%= link_to("Errors", step_errors_path, aria: { current: controller_name == "step_errors" ? "page" : nil }) %>
        </nav>

        <span class="version">v<%= Ductwork::VERSION %></span>
      </div>
    </header>

    <main class="shell">
      <%= yield %>
    </main>
  </body>
</html>
